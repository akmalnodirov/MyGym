# Shell scripts must keep LF endings or the shebang line carries a trailing \r
# and the interpreter is not found. This machine has core.autocrlf enabled, so
# without this the working copy gets CRLF on the next checkout.
*.sh text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.py  text eol=lf
# Docker reads the Dockerfile and Caddy reads the Caddyfile from the working copy, not from the
# index, so CRLF here would reach the tools themselves -- a trailing \r on a RUN line is a real
# source of confusing build failures on Linux.
Dockerfile text eol=lf
Caddyfile  text eol=lf
*.yml      text eol=lf
