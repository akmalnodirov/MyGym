# Copy to .env and fill in. Never commit .env.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Shared secret for the webhook endpoint. Must match what scripts/set-webhook.sh registered with
# Telegram; the script generates one and prints it if you have not chosen one yet.
TELEGRAM_WEBHOOK_SECRET=

# At least 32 bytes. Anything shorter makes HS256 token creation throw on the first request, and
# the API refuses to boot rather than let that happen later.
JWT_SIGNING_KEY=

# The HTTPS URL the bot's /start button opens. Telegram will not open a plain-http Mini App.
MINIAPP_URL=

# The hostname Caddy serves and obtains a certificate for. Leave unset for https://localhost with
# a local certificate, which is fine for local use and unreachable by Telegram.
MYGYM_DOMAIN=
